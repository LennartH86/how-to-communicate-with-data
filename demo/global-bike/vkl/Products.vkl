import db.storage.demos_467314_global_bike.products
import db.storage.demos_467314_global_bike.product_categories

kb {
    class Products {
        name.en: "Product"
        synonym.en: ["Bike", "Bicycle", "Item", "Article", "Model", "SKU", "Produkt"]
        description.en: "The 29 products Global Bike sells: touring, road, off-road, e-bikes and trend bikes plus accessories."

        from_table: products
        sql: "${products.product_id}"
        name_sql.en: "${products.product_name}"

        synced_description: "Global Bike products (29) with category, division, list price and unit cost in USD."

        default_date: Launch_Year
        default_order: kb.Sales_Order_Lines.Revenue_Usd
        extends: onto.Product

        // note: listing with_Category here makes Studio fail with "non-existing object kb.kb"
        display_with: [
            Division,
            List_Price_Usd
        ]

        class Division {
            name.en: "Division"
            synonym.en: ["Product line", "Business unit"]
            description.en: "Bicycles or Accessories."

            sql: "${products.division}"
            name_sql: "${products.division_name}"
        }

        date Launch_Year {
            name.en: "Launch Year"
            synonym.en: ["Introduced", "First sold"]

            sql: "PARSE_DATE('%Y', cast(${products.launch_year} as string))"

            datetime_format: YearFormat
        }

        number List_Price_Usd {
            name.en: "List Price"
            synonym.en: ["Price", "Catalog price", "Unit price"]
            description.en: "Typical selling price per unit in USD before discount."
            unit: onto.Currency.USD
            default_aggregation: average

            sql: "${products.list_price_usd}"
        }

        string Product_Id {
            name.en: "Product Id"
            tag: KB_One2One

            sql: "${products.product_id}"

            extends: onto.ID
        }

        string Product_Name {
            name.en: "Product Name"

            sql: "${products.product_name}"

            extends: onto.Name
        }

        number Unit_Cost_Usd {
            name.en: "Unit Cost"
            synonym.en: ["Cost per unit", "Production cost"]
            unit: onto.Currency.USD
            default_aggregation: average

            sql: "${products.unit_cost_usd}"
        }

        relationship with_Category {
            display_name.en: "in"
            to: kb.Category

            sql: "${products.category}"
        }
    }

    class Category {
        name.en: "Product Category"
        synonym.en: ["Category", "Bike type", "Product group", "Kategorie"]
        description.en: "Touring Bike, Road Bike, Offroad Bike, E Bike, Trend Bike and Accessories."

        from_table: product_categories
        sql: "${product_categories.category}"
        name_sql.en: "${product_categories.category_name}"

        default_order: kb.Sales_Order_Lines.Revenue_Usd
    }
}
